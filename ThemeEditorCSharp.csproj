<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>LianLiThemeEditor</AssemblyName>
    <RootNamespace>ThemeEditorCSharp</RootNamespace>
    <Version>2.9.2</Version>
    <AssemblyVersion>2.9.2.0</AssemblyVersion>
    <FileVersion>2.9.2.0</FileVersion>
    <InformationalVersion>2.9.2</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Title>Lian Li LCD Template Editor 2.9.2</Title>
    <AssemblyTitle>Lian Li LCD Template Editor 2.9.2</AssemblyTitle>
    <Product>Lian Li LCD Template Editor</Product>
    <Description>Theme editor for Lian Li LCD devices</Description>
    <Company>Ozgur Yalcin</Company>
    <Authors>Ozgur Yalcin</Authors>
    <Copyright>Copyright (c) Ozgur Yalcin 2026</Copyright>
    <ApplicationIcon>editor.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseAppHost>true</UseAppHost>
    <BaseOutputPath>bin_build\</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**;outputs\**;tmp\**;tmp_*\**;release\**;bin\**;bin_build\**;obj\**;obj_build\**;Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="editor.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets\glass-background.png" />
    <Resource Include="Assets\glass-background-light.png" />
    <Resource Include="Assets\Devices\hydroshift-ii-lcd-s.png" />
    <Resource Include="Assets\Devices\hydroshift-ii-lcd-c.png" />
    <Resource Include="Assets\Devices\universal-screen-8.8.png" />
    <Resource Include="Assets\Devices\vm-9.2.png" />
    <Resource Include="Assets\Devices\hydroshift-ii-oled-curve.png" />
    <Resource Include="Assets\Icons\rotate-orientation-white.png" />
    <Resource Include="Assets\Icons\screenshot-white.png" />
    <Resource Include="Assets\Icons\offline-white.png" />
    <Resource Include="Assets\Icons\import-theme.png" />
    <Resource Include="Assets\Icons\export-theme.png" />
    <Resource Include="Assets\Icons\update-theme-info.png" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

  <ItemGroup>
    <None Include="lang\**\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="editor.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="PhoneLinkWeb\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="templates\blank-seeds\*.template" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="SupporterCs\bin\$(Configuration)\net48\LianLiThemeEditor.TemplateWorker.exe" Link="LianLiThemeEditor.TemplateWorker.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Condition="'$(SkipSupporterBuild)' != 'true'" />
    <None Include="SupporterCs\bin\$(Configuration)\net48\LianLiThemeEditor.TemplateWorker.exe.config" Link="LianLiThemeEditor.TemplateWorker.exe.config" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Condition="'$(SkipSupporterBuild)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="SupporterCs\**\*.cs" />
    <Compile Remove="Tests\**\*.cs" />
  </ItemGroup>

  <Target Name="BuildCSharpSupporter" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipSupporterBuild)' != 'true'">
    <MSBuild Projects="$(MSBuildProjectDirectory)\SupporterCs\SupporterCs.csproj" Targets="Restore;Build" Properties="Configuration=$(Configuration)" RemoveProperties="RuntimeIdentifier;RuntimeIdentifiers;SelfContained" />
  </Target>

  <Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <BuildTimestamp>$([System.DateTime]::Now.ToString("yyyy-MM-dd HH:mm:ss zzz"))</BuildTimestamp>
      <BuildInfoFile>$(IntermediateOutputPath)GeneratedBuildInfo.g.cs</BuildInfoFile>
    </PropertyGroup>
    <ItemGroup>
      <BuildInfoLines Include="// &lt;auto-generated /&gt;" />
      <BuildInfoLines Include="namespace ThemeEditorCSharp" />
      <BuildInfoLines Include="{" />
      <BuildInfoLines Include="internal static class BuildInfo" />
      <BuildInfoLines Include="{" />
      <BuildInfoLines Include="    public const string BuiltAt = &quot;$(BuildTimestamp)&quot;%3B" />
      <BuildInfoLines Include="}" />
      <BuildInfoLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(BuildInfoFile)" Lines="@(BuildInfoLines)" Overwrite="true" Encoding="UTF-8" />
    <ItemGroup>
      <Compile Include="$(BuildInfoFile)" AutoGen="True" DesignTime="True" />
    </ItemGroup>
  </Target>

</Project>
